* stpaf_cert_xcmem.do  --  certification of stpaf 0.13.0/0.14.0 (test 21): column-version storage of
* the counterfactual design matrices, the blockwise influence-function covariance (0.13.0) and the
* vectorized risk-set sums, information and scores (0.14.0).
* Every result is compared with stpaf 0.12.0, run as -stpaf0120- (frozen copy generated by
* run_stpaf_0140.do from the validated 0.12.0 ado-file). Expected: point estimates (PAF, E, E_cf)
* equal up to rounding: points < 1e-11, standard errors / CIs / r(V_paf) < 1e-9 (summation order).
*
*  21a. influence function, model A (i.x##c.age c.z##c.w): eliminate(); each; combined() (versions
*       11, passes 3); varlevels(); if; citrans(none) level(90); a change entering i.x#c.age;
*       ifchunk(7) = one block, ifchunk(1) = one block; grouped indicators (model B)
*  21b. jackknife (20 clusters): Newton (combined, each, varlevels), nowarm, refit
*  21c. efron with tied failure times: Efron IF, Efron Newton jackknife (400 clusters); exactm -> refit
*  21d. edge cases: changed variable not in the model (0 versions), duplicate changes of one
*       variable with each, abbreviated variable in set(), c.w##i.z, fweights without clusters
*       (one record per cluster) with and without small blocks
*  21e. after mi estimate (saved fits): IF and jackknife
*  21f. memory and time: K = 6 and K = 8 on larger data, 0.12.0 vs current version (IF and jackknife);
*       K = 8 on large data with 0.13.0 only (local bigrun)

version 15.0
clear all
set more off
set type double
set seed 20261104
local bigrun 1
local nbig 2500
local nhuge 15000

* ----------------------------------------------------------------------------- helpers
capture program drop _cxm_sim
program define _cxm_sim
    syntax, n(integer) [ROUND]
    clear
    set obs `n'
    gen long id = _n
    gen double age = rnormal()
    gen byte stratum = 1 + (runiform() > .5)
    gen byte xb = floor(3*runiform())
    gen byte z = runiform() < .4
    gen double w = rnormal()
    forvalues j = 1/9 {
        gen byte v`j' = runiform() < .3
    }
    gen double C = 2 + 3*runiform()
    gen double sw = rexponential(2)
    gen double fr = rgamma(2, .5)
    gen double e0 = cond(runiform() < .3, .5*runiform(), 0)
    gen double len0 = min(sw, C)
    gen double len1 = max(C - sw, 0)
    gen double lp = 0.3*age + 0.5*z + 0.2*w + 0.15*z*w + 0.1*v1
    gen double r0 = (0.6 + 0.4*(stratum == 2))*fr*exp(lp + 0.35*xb + 0.1*xb*age)
    gen double r1 = (0.6 + 0.4*(stratum == 2))*fr*exp(lp + 0.35*(xb + 1) + 0.1*(xb + 1)*age)
    gen long n0 = rpoisson(r0*len0)
    gen long n1 = rpoisson(r1*len1)
    expand n0 + n1 + 1
    bysort id: gen long k = _n
    gen double tev = .
    replace tev = runiform()*len0 if k <= n0
    replace tev = sw + runiform()*len1 if k > n0 & k <= n0 + n1
    replace tev = C if k == n0 + n1 + 1
    gen byte ev = k <= n0 + n1
    if "`round'" != "" replace tev = ceil(4*tev)/4
    gsort id tev -ev
    by id: gen double tstart = cond(_n == 1, 0, tev[_n-1])
    drop if tev <= tstart
    stset tev, id(id) failure(ev) time0(tstart) enter(time e0) exit(time .)
    stsplit blk, after(time = sw) at(0)
    gen byte x = xb + (_t0 >= sw)
    forvalues j = 0/3 {
        gen byte d`j' = (x == `j')
    }
    gen int grp = 1 + mod(id, 20)
end

capture mata: mata drop _cxm_*()
mata:
// largest relative difference |a-b|/(|b|+1) over the columns cl; both missing = equal
real scalar _cxm_rd(real matrix A, real matrix B, real rowvector cl0)
{
    real matrix a, b
    real rowvector cl
    real scalar d
    cl = select(cl0, cl0 :<= cols(A))
    a = A[., cl]
    b = B[., cl]
    if (any((a :>= .) :!= (b :>= .))) return(1e300)
    a = editmissing(a, 0)
    b = editmissing(b, 0)
    d = max(abs(a - b) :/ (abs(b) :+ 1))
    return(d)
}
// old vs new: points (paf E E_cf), se/CI/se_logR (and mi columns), V (scaled)
void _cxm_cmp(string scalar ot, string scalar nt, string scalar ov, string scalar nv)
{
    real matrix TO, TN, VO, VN
    real scalar m
    TO = st_matrix(ot)
    TN = st_matrix(nt)
    VO = st_matrix(ov)
    VN = st_matrix(nv)
    if (rows(TO) != rows(TN) | cols(TO) != cols(TN) | rows(VO) != rows(VN)) {
        st_numscalar("CXDP", 1e300)
        st_numscalar("CXDS", 1e300)
        st_numscalar("CXDV", 1e300)
        return
    }
    st_numscalar("CXDP", max((_cxm_rd(TO, TN, (1, 2, 3, 7, 8, 10)), 0)))
    st_numscalar("CXDS", _cxm_rd(TO, TN, (4, 5, 6, 9, 11, 12, 13)))
    m = max(abs(VO))
    if (hasmissing(VO) | hasmissing(VN)) st_numscalar("CXDV", 1e300)
    else st_numscalar("CXDV", max(abs(VO - VN))/(m > 0 ? m : 1))
}
// largest relative difference of two whole matrices (same run, different options)
real scalar _cxm_mrd(string scalar an, string scalar bn)
{
    real matrix A, B
    A = st_matrix(an)
    B = st_matrix(bn)
    if (rows(A) != rows(B) | cols(A) != cols(B)) return(1e300)
    return(_cxm_rd(A, B, (1..cols(A))))
}
end

* stpaf0120 vs stpaf with the same options; asserts and one line of results
capture program drop _cxm_eq
program define _cxm_eq
    syntax [if] , Opts(string asis) What(string) [NEWopts(string asis) Cols(integer -1) ///
        Builds(integer -1) Chunks(integer -1)]
    qui stpaf0120 `if', `opts'
    matrix CXO_T = r(table)
    matrix CXO_V = r(V_paf)
    local ovce "`r(vce)'"
    local ojk "`r(jk_method)'"
    local onsc = rowsof(CXO_T)
    qui stpaf `if', `opts' `newopts'
    matrix CXN_T = r(table)
    matrix CXN_V = r(V_paf)
    local nvce "`r(vce)'"
    local njk "`r(jk_method)'"
    local ncol = r(xc_cols)
    local nb = r(xc_builds)
    local nch = r(if_chunks)
    mata: _cxm_cmp("CXO_T", "CXN_T", "CXO_V", "CXN_V")
    di as txt "   " %-44s "`what'" " points " %8.1e scalar(CXDP) "  se/CI " %8.1e scalar(CXDS) ///
        "  V " %8.1e scalar(CXDV) "  [versions `ncol', passes `nb', IF blocks `nch']"
    assert "`nvce'" == "`ovce'" & "`njk'" == "`ojk'"
    assert scalar(CXDP) < 1e-11
    assert scalar(CXDS) < 1e-9
    assert scalar(CXDV) < 1e-9
    if `cols' >= 0 assert `ncol' == `cols'
    if `builds' >= 0 assert `nb' == `builds'
    if `chunks' >= 0 assert `nch' == `chunks'
end

local coxA "stcox i.x##c.age c.z##c.w, strata(stratum) vce(cluster id) breslow"
local coxB "stcox d1 d2 d3 age c.d1#c.age c.d2#c.age c.d3#c.age c.z##c.w, strata(stratum) vce(cluster id) breslow"
local f3 "set(x=0) eliminate(z) cap(w=0)"

which stpaf
which stpaf0120

* =========================================================================== 21a
_cxm_sim, n(400)
qui `coxA'
di as txt _n "21a: influence function"
_cxm_eq, opts(eliminate(z) horizon(1 2.5) vce(if)) what("eliminate(z)") cols(2) builds(1) chunks(1)
_cxm_eq, opts(`f3' each horizon(1 2.5) vce(if)) what("set eliminate cap, each") cols(11) builds(3)
_cxm_eq, opts(combined(`f3') subsets horizon(1 2.5) vce(if)) what("combined(f3)") cols(11) builds(3)
_cxm_eq, opts(varlevels(x) horizon(1 2.5) vce(if)) what("varlevels(x)") cols(24) builds(4)
_cxm_eq if age > 0, opts(combined(`f3') vce(if) citrans(none) level(90)) what("combined(f3) if age > 0, citrans(none)")
_cxm_eq, opts(set(x=1) cap(age=0) each horizon(1 2.5) vce(if)) what("set(x=1) cap(age=0) each (x#age)")
_cxm_eq, opts(combined(`f3') horizon(1 2.5) vce(if)) newopts(ifchunk(7)) what("combined(f3), blocks of 7 clusters")
* one block = small blocks within the new version
qui stpaf, combined(`f3') horizon(1 2.5) vce(if)
matrix T1 = r(table)
matrix V1 = r(V_paf)
qui stpaf, combined(`f3') horizon(1 2.5) vce(if) ifchunk(1)
assert r(if_chunks) == r(N_clust)
matrix T2 = r(table)
matrix V2 = r(V_paf)
mata: st_numscalar("CXD", max((_cxm_mrd("T1", "T2"), _cxm_mrd("V1", "V2"))))
di as txt "   one block vs blocks of 1 cluster: max rel. difference " %8.1e scalar(CXD)
assert scalar(CXD) < 1e-12
qui `coxB'
_cxm_eq, opts(combined((eliminate(d1) eliminate(d2 d3)) eliminate(z) cap(w=0)) horizon(1 2.5) vce(if)) ///
    what("model B, grouped indicators")
di as txt "[ok] 21a"

* =========================================================================== 21b
qui `coxA'
di as txt _n "21b: jackknife (20 clusters)"
_cxm_eq, opts(combined(`f3') horizon(1 2.5) cluster(grp)) what("combined(f3), Newton")
_cxm_eq, opts(`f3' each horizon(1 2.5) cluster(grp)) what("each, Newton")
_cxm_eq, opts(varlevels(x) horizon(1 2.5) cluster(grp)) what("varlevels(x), Newton")
_cxm_eq, opts(combined(`f3') cluster(grp) nowarm) what("combined(f3), Newton nowarm")
_cxm_eq, opts(eliminate(z) cap(w=0) each horizon(1 2.5) cluster(grp) refit nodots) what("each, stcox refits")
di as txt "[ok] 21b"

* =========================================================================== 21c
preserve
_cxm_sim, n(400) round
qui stcox i.x##c.age c.z##c.w, strata(stratum) vce(cluster id) efron
di as txt _n "21c: efron with tied failure times"
_cxm_eq if age > -1, opts(combined(`f3') horizon(1 2.5) vce(if)) what("Efron IF, if age > -1")
_cxm_eq if age > -1, opts(combined(`f3') horizon(1 2.5) vce(jackknife)) what("Efron Newton jackknife, 400 clusters")
qui stcox i.x##c.age c.z##c.w, strata(stratum) exactm
_cxm_eq, opts(set(x=0) eliminate(z) each cluster(grp) nodots) what("exactm, stcox refits")
restore
di as txt "[ok] 21c"

* =========================================================================== 21d
qui `coxA'
di as txt _n "21d: edge cases"
_cxm_eq, opts(eliminate(v9) horizon(1 2.5) vce(if)) what("variable not in the model") cols(0) builds(0)
_cxm_eq, opts(eliminate(v9) cluster(grp)) what("variable not in the model, jackknife") cols(0) builds(0)
_cxm_eq, opts(combined(eliminate(v9) cap(w=0)) vce(if)) what("combined with a factor not in the model")
_cxm_eq, opts(eliminate(z) set(z=1) each horizon(1 2.5) vce(if)) what("eliminate(z) set(z=1) each")
* abbreviated variable in set(): same result as the full name
local vab = c(varabbrev)
set varabbrev on
qui stpaf, set(age=0.5) horizon(1 2.5) vce(if)
matrix T1 = r(table)
capture qui stpaf, set(ag=0.5) horizon(1 2.5) vce(if)
if _rc di as txt "   set(ag=0.5): rc = " _rc " (abbreviation not accepted; skipped)"
else {
    matrix T2 = r(table)
    mata: st_numscalar("CXD", _cxm_mrd("T1", "T2"))
    di as txt "   set(ag=0.5) vs set(age=0.5): max rel. difference " %8.1e scalar(CXD)
    assert scalar(CXD) < 1e-14
}
set varabbrev `vab'
qui stcox c.w##i.z age, strata(stratum) breslow
_cxm_eq, opts(combined(cap(w=0) set(z=0)) subsets horizon(1 2.5) vce(if)) what("c.w##i.z combined") cols(5) builds(3)
* fweights without clusters: one record per cluster
preserve
clear
set obs 300
gen byte z = runiform() < .5
gen double w = rnormal()
gen double t = rexponential(1)/exp(.5*z + .3*w)
gen byte d = t < 2
replace t = min(t, 2)
gen int fw = 1 + floor(3*runiform())
stset t [fw=fw], failure(d)
qui stcox z w, breslow
_cxm_eq, opts(eliminate(z) set(w=0) each horizon(.5 1) vce(if)) what("fweights, one record per cluster")
_cxm_eq, opts(combined(eliminate(z) set(w=0)) horizon(.5 1) vce(if)) newopts(ifchunk(13)) ///
    what("fweights, combined, blocks of 13 records")
restore
di as txt "[ok] 21d"

* =========================================================================== 21e
preserve
_cxm_sim, n(400)
keep if _st == 1
gen double t0b = _t0
gen double t1b = _t
gen byte db = _d
stset, clear
keep id t0b t1b db x d0 d1 d2 d3 age z w stratum grp
gen double u = runiform()
bysort id (t0b): replace u = u[1]
replace w = . if u < .3
drop u
mi set flong
mi register imputed w
mi register regular x d0 d1 d2 d3 age z stratum db t0b t1b grp id
mi impute regress w i.x z age i.stratum db, add(5) rseed(21)
mi stset t1b, id(id) failure(db) time0(t0b) exit(time .)
capture erase f21e.ster
qui mi estimate, saving(f21e, replace): `coxA'
di as txt _n "21e: after mi estimate"
_cxm_eq, opts(combined(`f3') horizon(1 2.5) vce(if)) what("mi, combined(f3), IF")
_cxm_eq, opts(`f3' each horizon(1 2.5) cluster(grp) citrans(none)) what("mi, each, jackknife, citrans(none)")
capture erase f21e.ster
restore
di as txt "[ok] 21e"

* =========================================================================== 21f
di as txt _n "21f: memory and time, 0.12.0 vs current version"
_cxm_sim, n(`nbig')
qui stcox i.x##c.age c.z##c.w v1-v8, strata(stratum) vce(cluster id) breslow
local N = e(N)
tempname bb
matrix `bb' = e(b)
_ms_omit_info `bb'
local p = colsof(`bb') - r(k_omit)
di as txt "   data: `nbig' subjects, `N' records, p = `p' non-omitted columns"
di as txt "   {hline 100}"
di as txt "   K  variance   clusters  time 0.12.0  time new      X^c storage 0.12.0 -> new" ///
    "   IF Psi 0.12.0 -> new   passes"
di as txt "   {hline 100}"
foreach K in 6 8 {
    local spec = cond(`K' == 6, "`f3' eliminate(v1 v2 v3)", "`f3' eliminate(v1-v5)")
    local nsc = 2^`K' - 1
    foreach v in if jk {
        local o = cond("`v'" == "if", "vce(if)", "cluster(grp)")
        timer clear
        timer on 1
        qui stpaf0120, combined(`spec') `o'
        timer off 1
        matrix CXO_T = r(table)
        matrix CXO_V = r(V_paf)
        timer on 2
        qui stpaf, combined(`spec') `o'
        timer off 2
        matrix CXN_T = r(table)
        matrix CXN_V = r(V_paf)
        local G = r(N_clust)
        local ncol = r(xc_cols)
        local nb = r(xc_builds)
        assert r(sumdiff) < 1e-12
        mata: _cxm_cmp("CXO_T", "CXN_T", "CXO_V", "CXN_V")
        assert scalar(CXDP) < 1e-11 & scalar(CXDS) < 1e-9 & scalar(CXDV) < 1e-9
        qui timer list
        local t1 = r(t1)
        local t2 = r(t2)
        local mo = `nsc'*`N'*`p'*8/2^20
        local mn = `ncol'*`N'*8/2^20
        local po = `G'*`nsc'*8/2^20
        local pn = min(`G', floor(2^24/`nsc'))*`nsc'*8/2^20
        di as txt "   `K'  " %-9s "`v'" %9.0f `G' %12.2f `t1' " s" %11.2f `t2' " s" ///
            %14.1f `mo' " MB ->" %7.2f `mn' " MB" %11.2f `po' " MB ->" %6.2f `pn' " MB" %6.0f `nb' "/" `nsc'
    }
}
di as txt "   {hline 100}"
di as txt "   (equal results: points < 1e-11, se/CI and V < 1e-9 in every row)"
if `bigrun' {
    _cxm_sim, n(`nhuge')
    qui stcox i.x##c.age c.z##c.w v1-v8, strata(stratum) vce(cluster id) breslow
    local N = e(N)
    timer clear
    timer on 3
    qui stpaf, combined(`f3' eliminate(v1-v5)) vce(if)
    timer off 3
    local G = r(N_clust)
    local ncol = r(xc_cols)
    local nb = r(xc_builds)
    assert r(sumdiff) < 1e-12 & r(K) == 8
    qui timer list
    local t3 = r(t3)
    di as txt "   large data, current version only: `nhuge' subjects, `N' records, K = 8, IF: " %7.2f `t3' " s;" ///
        " X^c storage " %6.2f `ncol'*`N'*8/2^20 " MB (0.12.0 would need " %7.0f 255*`N'*`p'*8/2^20 " MB)"
}
di as txt "[ok] 21f"

di as res _n "stpaf column-version / vectorization certification finished (21a-f)"
